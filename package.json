{
  "name": "vaultkey",
  "version": "1.0.0",
  "description": "VaultKey — a privacy-first password and passphrase generator that runs entirely in your browser.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/preview.mjs",
    "test": "node --import tsx --test \"tests/unit/**/*.test.ts\"",
    "test:e2e": "node scripts/build.mjs && node --test --test-concurrency=1 \"tests/e2e/**/*.test.mjs\"",
    "test:all": "npm test && npm run test:e2e",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:lib": "tsc --noEmit -p tsconfig.lib.json",
    "wordlist": "node scripts/build-wordlist.mjs",
    "audit:deps": "npm audit --omit=dev"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3"
  }
}
